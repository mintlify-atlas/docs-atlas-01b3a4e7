  "$schema": "https://mintlify.com/docs.json",
  "name": "tailwindcss-animate",
  "theme": "willow",
  "colors": {
    "primary": "#0ea5e9",
    "light": "#e0f2fe",
    "dark": "#0369a1"
  },
  "navbar": {
    "primary": {
      "type": "github",
      "href": "https://github.com/jamiebuilds/tailwindcss-animate"
    }
  },
  "footer": {
